#!/usr/bin/python3 -I
# raios-ffx: Final Fantasy X, Thunder Plains lightning auto-dodge
# Dodges the lightning bolts on its own while playing over Remote Play
# with Chiaki (chiaki-ng) on Linux.
#
# How it works: it looks at the Chiaki window ~60 times per second; when the
# window suddenly gets bright (the lightning flash), it presses Cross on an
# extra virtual controller. Chiaki merges the buttons of every connected
# controller and sends them to the console.
#
# Messages are shown in Portuguese if the system language is Portuguese,
# and in English otherwise.
#
# Usage:  raios-ffx                 -> automatic mode (Ctrl+C to stop)
#         raios-ffx --test          -> only shows the screen brightness, presses nothing
#         raios-ffx --delay 50      -> waits 50 ms after the flash before pressing
#         (Portuguese aliases also work: --teste, --atraso)
#
# MIT License.
import os, sys, time, struct, fcntl, subprocess
from Xlib import display, X

FLASH_JUMP = 55     # how much the brightness must jump suddenly to count as lightning
COOLDOWN = 1.2      # seconds without pressing again after a bolt
BTN_CROSS = 0x122   # Cross button in the mapping Chiaki uses for this virtual controller

# --- language -------------------------------------------------------------
def _system_language():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG", "LANGUAGE"):
        value = os.environ.get(var, "")
        if value:
            return value.lower()
    return ""

PT = _system_language().startswith("pt")

MSG = {
    "test_mode": ("Modo TESTE: só mostrando o brilho.",
                  "TEST mode: only showing the brightness."),
    "running":   ("Rodando! Pode andar pelas Planícies dos Trovões (de preferência em volta das crateras). Ctrl+C para parar.",
                  "Running! You can walk around the Thunder Plains (preferably around the craters). Ctrl+C to stop."),
    "no_window": ("Não achei a janela do Chiaki, esperando...",
                  "Couldn't find the Chiaki window, waiting..."),
    "bolt":      ("⚡ raio {n}  (brilho {a} -> {b})",
                  "⚡ bolt {n}  (brightness {a} -> {b})"),
    "level":     ("brilho {b}  normal {a}",
                  "brightness {b}  normal {a}"),
    "stopped":   ("\nParado. Raios detectados: {n}",
                  "\nStopped. Bolts detected: {n}"),
}

def msg(key, **kw):
    return MSG[key][0 if PT else 1].format(**kw)

# --- options --------------------------------------------------------------
def _option_value(names):
    for name in names:
        if name in sys.argv:
            return int(sys.argv[sys.argv.index(name) + 1])
    return None

TEST = "--test" in sys.argv or "--teste" in sys.argv
_delay_ms = _option_value(("--delay", "--atraso"))
DELAY = _delay_ms / 1000 if _delay_ms else 0.0

# --- program --------------------------------------------------------------
def chiaki_window():
    out = subprocess.run(["wmctrl", "-lG"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        p = line.split(None, 7)
        if len(p) >= 8 and "chiaki" in p[7].lower():
            x, y, w, h = map(int, p[2:6])
            return x, y, w, h
    return None

def ioc(d, t, nr, size):
    return (d << 30) | (size << 16) | (ord(t) << 8) | nr

def create_controller():
    u = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(u, ioc(1, "U", 100, 4), 1)   # EV_KEY
    fcntl.ioctl(u, ioc(1, "U", 100, 4), 3)   # EV_ABS
    for k in range(0x120, 0x12C):
        fcntl.ioctl(u, ioc(1, "U", 101, 4), k)
    absmin = [0] * 64; absmax = [0] * 64; flat = [0] * 64
    for a in (0, 1, 2, 5):
        fcntl.ioctl(u, ioc(1, "U", 103, 4), a); absmax[a] = 255; flat[a] = 15
    for a in (0x10, 0x11):
        fcntl.ioctl(u, ioc(1, "U", 103, 4), a); absmin[a] = -1; absmax[a] = 1
    data = b"Raios FFX".ljust(80, b"\0") + struct.pack("HHHHi", 3, 0x0810, 0x0001, 0x0110, 0)
    data += struct.pack("64i", *absmax) + struct.pack("64i", *absmin)
    data += struct.pack("64i", *([0] * 64)) + struct.pack("64i", *flat)
    os.write(u, data)
    fcntl.ioctl(u, ioc(0, "U", 1, 0))
    for a in (0, 1, 2, 5):   # analog sticks resting in the center
        os.write(u, struct.pack("llHHi", 0, 0, 3, a, 127))
    os.write(u, struct.pack("llHHi", 0, 0, 0, 0, 0))
    return u

def press(u, button):
    ev = lambda t, c, v: struct.pack("llHHi", 0, 0, t, c, v)
    os.write(u, ev(1, button, 1) + ev(0, 0, 0))
    time.sleep(0.08)
    os.write(u, ev(1, button, 0) + ev(0, 0, 0))

def brightness(root, x, y, w, h):
    # takes the middle of the window (skips the borders and the title bar)
    cx, cy, cw, ch = x + w // 8, y + h // 8, w * 3 // 4, h * 3 // 4
    img = root.get_image(cx, cy, cw, ch, X.ZPixmap, 0xFFFFFFFF).data
    sample = img[1::4 * 37]           # green channel, 1 out of every 37 pixels
    return sum(sample) / max(1, len(sample))

def main():
    d = display.Display()
    root = d.screen().root
    u = None if TEST else create_controller()
    if u:
        time.sleep(1.5)   # gives Chiaki time to notice the new controller
    print(msg("test_mode") if TEST else msg("running"), flush=True)
    base = None; last = 0; bolts = 0; geo = None; geo_t = 0; t_log = time.time()
    try:
        while True:
            now = time.time()
            if geo is None or now - geo_t > 3:
                geo = chiaki_window(); geo_t = now
                if geo is None:
                    print(msg("no_window"), flush=True)
                    time.sleep(2); continue
            b = brightness(root, *geo)
            if base is None:
                base = b
            if b - base > FLASH_JUMP and now - last > COOLDOWN:
                last = now; bolts += 1
                if u:
                    if DELAY: time.sleep(DELAY)
                    press(u, BTN_CROSS)
                print(msg("bolt", n=bolts, a=f"{base:.0f}", b=f"{b:.0f}"), flush=True)
            elif b - base <= FLASH_JUMP:
                base = base * 0.9 + b * 0.1      # follows the normal brightness of the scene
            if TEST and now - t_log > 0.5:
                print(msg("level", b=f"{b:.0f}", a=f"{base:.0f}"), flush=True); t_log = now
            time.sleep(0.008)
    except KeyboardInterrupt:
        print(msg("stopped", n=bolts), flush=True)
    finally:
        if u:
            fcntl.ioctl(u, ioc(0, "U", 2, 0)); os.close(u)

if __name__ == "__main__":
    main()
